# ── Skill Lens — Environment Template ────────────────────────────────
# Copy this file to `.env` and fill in your own keys. NEVER commit `.env`.
#
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)

# Primary LLM provider: "openrouter" (default) or "groq"
LLM_PROVIDER=openrouter

# ── OpenRouter (primary provider) ─────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Groq (fallback provider) ──────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ── Hugging Face (optional — for gated models) ────────────────────────
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# ── Optional — GPU re-indexing ────────────────────────────────────────
# Set to "cuda" to rebuild the ChromaDB index on the GPU (requires a CUDA
# build of torch). Defaults to "cpu". See docs/MASTER.md.
# REINDEX_DEVICE=cpu
